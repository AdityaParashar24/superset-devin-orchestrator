# ---- Devin ----
# Service user token: app.devin.ai > Settings > Service Users (needs ManageOrgSessions)
DEVIN_API_KEY=
# Your org id (prefix org-). GET https://api.devin.ai/v3/enterprise/organizations
DEVIN_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai/v3

# ---- GitHub ----
# PAT (or fine-grained token) with issues:write + pull_requests:read on the repo
GITHUB_TOKEN=
GITHUB_REPO=AdityaParashar24/superset

# ---- Backend ----
# Shared secret the GitHub Action uses to authenticate to /api/webhook/github
BACKEND_SECRET=change-me
DB_PATH=enablement.db
POLL_INTERVAL_SECONDS=20

# Per-role ACU caps (safety)
TRIAGE_MAX_ACU=5
REMEDIATION_MAX_ACU=30
REVIEW_MAX_ACU=10

# Set DEMO_MODE=true to run the whole console without real credentials.
# Sessions are simulated so you can see the pipeline end-to-end locally.
DEMO_MODE=false
