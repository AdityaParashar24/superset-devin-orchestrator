# ---- Devin ----
# Service user token: app.devin.ai > Settings > Service Users (needs ManageOrgSessions)
DEVIN_API_KEY=
# Your org id (prefix org-). GET https://api.devin.ai/v3/enterprise/organizations
DEVIN_ORG_ID=

# ---- GitHub ----
# PAT (or fine-grained token) with issues:write + pull_requests:read on the repo
GITHUB_TOKEN=
GITHUB_REPO=AdityaParashar24/superset

# ---- Backend ----
POLL_INTERVAL_SECONDS=8

# Per-role ACU caps (safety)
TRIAGE_MAX_ACU=5
REMEDIATION_MAX_ACU=30
